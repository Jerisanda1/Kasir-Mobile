<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Izin Bluetooth untuk cetak struk ke printer thermal -->
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <!-- WAJIB juga di Android 12+: library printer (DantSu ESCPOS) memanggil
         BluetoothAdapter.cancelDiscovery() secara internal sebelum connect(),
         dan method itu butuh BLUETOOTH_SCAN terpisah dari BLUETOOTH_CONNECT.
         Pakai "neverForLocation" karena aplikasi ini TIDAK melakukan scan/discovery
         perangkat baru (cuma baca daftar yang sudah paired), jadi tidak butuh
         izin lokasi sama sekali. -->
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation" />
    <application
        android:usesCleartextTraffic="true"
        android:allowBackup="true"
        android:icon="@drawable/logo_jimbomart"
        android:label="@string/app_name"
        android:roundIcon="@drawable/logo_jimbomart"
        android:supportsRtl="true"
        android:theme="@style/Theme.AppCompat.Light.NoActionBar">

        <activity
            android:name=".SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.AppCompat.Light.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>

        <activity
            android:name=".LoginActivity"
            android:exported="false">
        </activity>

        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize"/>

    </application>
</manifest>
