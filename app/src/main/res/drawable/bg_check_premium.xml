<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Shadow-like outer glow -->
    <item>
        <shape android:shape="oval">
            <solid android:color="#1A048967"/>
            <size android:width="100dp" android:height="100dp"/>
        </shape>
    </item>
    <!-- Secondary circle -->
    <item android:top="10dp" android:bottom="10dp" android:left="10dp" android:right="10dp">
        <shape android:shape="oval">
            <solid android:color="#33048967"/>
        </shape>
    </item>
    <!-- Main circle -->
    <item android:top="20dp" android:bottom="20dp" android:left="20dp" android:right="20dp">
        <shape android:shape="oval">
            <solid android:color="#048967"/>
            <stroke android:width="4dp" android:color="#FFFFFF"/>
        </shape>
    </item>
</layer-list>
